# Dependencies
node_modules/

# VitePress build output and cache
docs/.vitepress/cache/
docs/.vitepress/dist/

# Generated artefacts. These are rebuilt deterministically by
# `pnpm run generate` before every build, so they are never committed.
docs/.vitepress/data/generated/
docs/public/search-index.json
docs/public/implementations/
docs/implementations/

# Scratch directories used by the validation tooling
.tmp/
tmp/
*.tmp

# Editor and operating-system noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
