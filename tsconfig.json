{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": false,
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "types": ["node", "vite/client"],
        "baseUrl": ".",
        "paths": {
            "@theme/*": ["./docs/.vitepress/theme/*"],
            "@data/*": ["./docs/.vitepress/data/*"]
        }
    },
    "include": [
        "docs/.vitepress/**/*.ts",
        "docs/.vitepress/**/*.vue",
        "docs/.vitepress/theme/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "docs/.vitepress/cache", "docs/.vitepress/dist"]
}
