{
    "name": "aayntn",
    "version": "1.0.0",
    "description": "A.A.Y.N.T.N. — All Algorithms You Need to Know. A static, Markdown-authored competitive programming encyclopedia for USACO preparation.",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "author": "Richard Jiang",
    "scripts": {
        "dev": "vitepress dev docs",
        "build": "vitepress build docs",
        "preview": "vitepress preview docs",
        "generate": "tsx tools/generate-indexes/index.ts",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "validate": "tsx tools/validate-content/index.ts",
        "validate:code": "tsx tools/validate-code/index.ts",
        "check:links": "tsx tools/check-links/index.ts",
        "scaffold": "tsx tools/scaffold/index.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "prebuild": "pnpm run generate && pnpm run format && pnpm run validate && pnpm run check:links",
        "check:base": "tsx tools/check-base/index.ts"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@mdit/plugin-katex": "^1.1.4",
        "katex": "^0.19.0",
        "minisearch": "^7.2.0",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@live-codes/pascal-wasm": "^0.1.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "@vue/compiler-dom": "^3.5.44",
        "fast-glob": "^3.3.3",
        "markdown-it": "^15.0.3",
        "oxfmt": "0.74.0",
        "shiki": "^4.5.0",
        "tsx": "^4.19.2",
        "typescript": "6.0.3",
        "vite": "^8.3.5",
        "vitepress": "^1.6.4",
        "vitest": "^5.0.5",
        "yaml": "^2.7.0",
        "zod": "^4.6.7"
    }
}
